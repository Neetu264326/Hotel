PORT=5000
# Local MongoDB: mongodb://127.0.0.1:27017/delishful
# Vercel/production MUST use a MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/delishful
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# AI Assistant (OpenAI-compatible)
# Works with OpenAI, DeepSeek, Groq, OpenRouter, Ollama etc.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=45000